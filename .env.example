# Copy to .env and fill in the key for whichever provider you use.
# .env is gitignored — never commit real keys.

# Anthropic (default provider; model claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=

# OpenAI (--provider openai; model gpt-4.1-mini)
OPENAI_API_KEY=


# DeepSeek (--provider deepseek; model deepseek-chat), OpenAI-compatible API at
# https://api.deepseek.com/v1 — pair with --embed-provider ollama for embeddings
DEEPSEEK_API_KEY=
