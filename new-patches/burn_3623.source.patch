+        matches!(
+            node.node_type,
+            NodeType::Add | NodeType::Sub | NodeType::Mul | NodeType::Div
+        ) && node.inputs.len() == 2
+            && node.node_type != NodeType::Constant
+            && node
+                .inputs
+                .iter()
+                .any(|input| changed_outputs.contains(&input.name))
