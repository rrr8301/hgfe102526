+fn mean_scalar_half<E>(tensor: &FlexTensor) -> FlexTensor
+where
+    E: Element + bytemuck::Pod,
+{
+    let tensor = tensor.to_contiguous();
+    let n = tensor.layout().num_elements();
+    let data = float_storage_as_f32(&tensor);
