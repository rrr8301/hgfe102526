+#[test]
+#[should_panic]
+fn test_mean_dim_empty_axis_int_should_panic() {
+    let tensor = TestTensorInt::<2>::empty([3, 0], &Default::default());
+
+    let _ = tensor.mean_dim(1).into_data();
+}
