@@ -145,3 +145,39 @@ def test_nonsingular_indefinite(self):
         A = sp.diags_array([offdiag, diag, offdiag], offsets=[-1, 0, 1])
         with self.assertRaises(ValueError, msg=lau.SparseCholeskyMessages.INDEFINITE):
