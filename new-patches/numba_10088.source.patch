diff --git a/docs/upcoming_changes/10088.bug_fix.rst b/docs/upcoming_changes/10088.bug_fix.rst
new file mode 100644
index 00000000000..3b2d73a9a08
--- /dev/null
+++ b/docs/upcoming_changes/10088.bug_fix.rst
@@ -0,0 +1,6 @@
+fix: handle ``nan`` correctly in ``np.unique``
+----------------------------------------------
+
+``np.unique`` overload has been updated to handle ``np.nan`` values correctly
+-- this fix also propagates to the ``np.union1d`` overload, fixing its behavior
+with ``np.nan`` inputs
diff --git a/numba/np/arrayobj.py b/numba/np/arrayobj.py
index 12f985c5cbc..5ce83df42c1 100644
--- a/numba/np/arrayobj.py
+++ b/numba/np/arrayobj.py
@@ -2647,7 +2647,10 @@ def np_unique(ar):
     def np_unique_impl(ar):
         b = np.sort(ar.ravel())
         head = list(b[:1])
-        tail = [x for i, x in enumerate(b[1:]) if b[i] != x]
+        tail = [
+            x for i, x in enumerate(b[1:])
+            if b[i] != x and not (np.isnan(b[i]) and np.isnan(x))
+        ]
         return np.array(head + tail)
     return np_unique_impl
 
