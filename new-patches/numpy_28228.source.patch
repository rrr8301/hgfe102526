+            if (na_cmp < 0) {
+                Py_DECREF(scalar_val);
+                goto fail;
+            }
+            if (na_cmp) {
+                Py_DECREF(scalar_val);
+                if (NpyString_pack_null(allocator, (npy_packed_static_string *)out) < 0) {
