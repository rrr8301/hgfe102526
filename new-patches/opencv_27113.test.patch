+
+    // Load the ground truth matrix from XML
     Mat gt;
     fs.getFirstTopLevelNode() >> gt;
 
+    // Compare the image loaded with IMREAD_UNCHANGED to the ground truth
     EXPECT_PRED_FORMAT2(cvtest::MatComparator(0, 0), src, gt);
