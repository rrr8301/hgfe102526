diff --git a/lib/node_modules/@stdlib/blas/ext/base/dcunone/test/test.dcunone.js b/lib/node_modules/@stdlib/blas/ext/base/dcunone/test/test.dcunone.js
index 4d9180b1ee6c..e371a6ac4a23 100644
--- a/lib/node_modules/@stdlib/blas/ext/base/dcunone/test/test.dcunone.js
+++ b/lib/node_modules/@stdlib/blas/ext/base/dcunone/test/test.dcunone.js
@@ -168,3 +168,25 @@ tape( 'the function supports a negative `out` stride', function test( t ) {
 
 	t.end();
 });
+
+tape( 'the function treats `NaN` as a falsy element', function test( t ) {
+	var expected;
+	var out;
+	var x;
+
+	x = new Float64Array( [ NaN, NaN, 1.0, 1.0 ] );
+	out = new BooleanArray( 4 );
+	expected = new BooleanArray( [ true, true, false, false ] );
+
+	dcunone( x.length, x, 1, out, 1 );
+	t.ok( isEqualBooleanArray( out, expected ), 'returns expected value' );
+
+	x = new Float64Array( [ NaN, NaN, NaN, NaN ] );
+	out = new BooleanArray( 4 );
+	expected = new BooleanArray( [ true, true, true, true ] );
+
+	dcunone( x.length, x, 1, out, 1 );
+	t.ok( isEqualBooleanArray( out, expected ), 'returns expected value' );
+
+	t.end();
+});
