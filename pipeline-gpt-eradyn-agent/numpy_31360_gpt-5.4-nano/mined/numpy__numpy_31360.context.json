  "numerical_failure": {
    "category": "correctness",
    "affected_api": "numpy.gcd",
    "observed_behavior": "np.gcd returns a negative value instead of the expected positive gcd when one input is INT_MIN on s390x.",
    "expected_behavior": "np.gcd should return the correct non-negative gcd value (e.g., 536870912 for the provided inputs).",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "Architecture: s390x",
      "When one argument to np.gcd is the minimum value of a signed integer type (INT_MIN), specifically np.int32(np.iinfo(np.int32).min) in the reproducer",
      "Overflow/undefined behavior arises from signed absolute value computation using `a < 0 ? -a : a` for INT_MIN"
    ],
    "input_output_examples": [
      {
        "input": "a = np.int32(np.iinfo(np.int32).min); q = -(a // 4); np.gcd(a, q * 3)",
        "buggy_output": "-536870912",
        "expected_output": "536870912",
        "value_kind": "float",
        "source": "issue#31359 (reproducer): prints -536870912 instead of 536870912; also shows Expected: 536870912 and Result: -536870912 on s390x/GCC 11.5.0"
      }
    ],
    "oracle_clues": [
      "The reproducer states: \"That should produce 536870912, instead it produces -536870912\".",
      "The test asserts `assert_equal(np.gcd(a,  q * 3), q)` with `a = np.int32(np.iinfo(np.int32).min)` and `q = -(a // 4)`, and reports ACTUAL `np.int32(-536870912)` vs DESIRED `np.int32(536870912)`.",
      "The root cause described: undefined behavior in signed-to-unsigned absolute value conversion using `a < 0 ? -a : a` when `a = INT_MIN` on s390x (GCC 11.5)."
    ]
  },
