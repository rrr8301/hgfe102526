  "numerical_failure": {
    "category": "special_value",
    "affected_api": "numpy.abs",
    "observed_behavior": "On wasm32/Pyodide, `np.abs(np.nan)` can produce a NaN with a flipped sign bit: `np.signbit(np.abs(np.nan))` prints `True` (i.e., returns a negative NaN signbit).",
    "expected_behavior": "`np.abs(np.nan)` should return a NaN with a positive sign bit: `np.signbit(np.abs(np.nan))` should be `False` (signbit `== 0`).",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "Running on wasm32/Pyodide (Emscripten/wasm32 environment)",
      "Using `np.abs` on NaN (`np.nan` or `-np.nan` values)",
      "Specifically observed: `np.signbit(np.abs(np.nan))` is incorrect (True) while `np.signbit(np.abs(-np.nan))` is expected/observed to be False"
    ],
    "input_output_examples": [
      {
        "input": "np.signbit(np.abs(np.nan))",
        "buggy_output": "True",
        "expected_output": "False",
        "value_kind": "boolean",
        "source": "issue:issue#31421 (reproducer example prints True? for abs(np.nan))"
      },
      {
        "input": "np.signbit(np.abs(-np.nan))",
        "buggy_output": "False",
        "expected_output": "False",
        "value_kind": "boolean",
        "source": "issue:issue#31421 (reproducer example prints False as expected)"
      },
      {
        "input": "for dtype in [np.float16, np.float32, np.float64, np.longdouble]: pos_nan=dtype(np.nan); np.signbit(np.abs(pos_nan))",
        "buggy_output": "null",
        "expected_output": "0",
        "value_kind": "integer",
        "source": "discussion:numpy/_core/tests/test_umath.py (assert_(np.signbit(np.abs(pos_nan)) == 0))"
      }
    ],
    "oracle_clues": [
      "Regression test requirement: `assert_(np.signbit(np.abs(pos_nan)) == 0, ...)` for dtypes float16/float32/float64/longdouble",
      "Issue reproducer indicates wrong signbit only for `np.abs(np.nan)`: `np.signbit(np.abs(np.nan))` prints `True` while `np.signbit(np.abs(-np.nan))` prints `False`",
      "Cause described: `LONGDOUBLE_absolute` used `tmp + 0` to clear -0.0 but corrupted the sign bit of NaN values"
    ]
  },
  "numerical_characteristics": {
    "dtype": "float16, float32, float64, longdouble (float types in the tests; signbit is checked for these)",
    "precision": null,
    "magnitude": null,
    "tolerance": null,
    "category_specific_evidence": [
      "Special values involved: NaN (including signed NaN, i.e., +NaN and -NaN).",
      "Where they enter: through np.abs applied to NaN values (both scalar and array).",
      "Observed incorrect behavior: np.signbit(np.abs(np.nan)) returns True on wasm32/Pyodide (while np.signbit(np.nan) is False as expected).",
      "Observed correct behavior after fix: abs(+nan) should have positive sign bit (assert not np.signbit(np.abs(+nan))).",
      "Observed correct behavior after fix: abs(-nan) should also have positive sign bit (assert not np.signbit(np.abs(-nan))).",
      "Array handling: signbit(np.abs(np.array([np.nan, -np.nan]))) should yield [False, False].",
      "Problem mechanism described: in LONGDOUBLE_absolute, an operation 'tmp + 0' used to clear -0.0 corrupted the sign bit of NaN values, causing np.signbit(np.abs(np.nan)) to return True."
    ],
    "reproduction_risks": [
      "The issue is specifically tied to wasm32/Pyodide; reproductions may fail outside that environment.",
      "Using only some float dtypes (e.g., only float32/float64 but not float16/longdouble) may miss coverage of the regression.",
      "Reproduction must check the sign bit via np.signbit, not just numerical equality of NaN."
    ]
  },
