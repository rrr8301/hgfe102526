  "numerical_failure": {
    "category": "convergence",
    "affected_api": "sklearn.cluster.KMeans.fit",
    "observed_behavior": "With n_clusters greater than the number of non-duplicate samples, KMeans keeps running/printing iterations even after inertia reaches 0.0 (e.g., with max_iter=10_000 it continues printing \u201cIteration 2, inertia 0.0.\u201d through many more iterations), due to relocation of empty clusters triggering at every iteration and preventing the algorithm from stopping.",
    "expected_behavior": "KMeans should stop once inertia becomes 0.0; the run should only perform the next iteration after inertia reaches 0.0 (so output should end after \u201cIteration 1, inertia 0.0.\u201d).",
    "manifestation": "hang",
    "trigger_conditions": [
      "More centers than non-duplicate samples (\u201cthere are more centers than non-duplicate samples\u201d)",
      "Empty-cluster relocation occurs at every iteration (\u201cthe relocation of empty cluster will trigger at every iteration preventing the algorithm to stop\u201d)",
      "max_iter set to a very large number or inf (e.g., max_iter=10_000), so termination does not occur due to default max_iterations=300"
    ],
    "input_output_examples": [
      {
        "input": "KMeans(n_clusters=6, init=init, random_state=0, verbose=True, algorithm='lloyd', max_iter=10_000).fit(X) where inertia becomes 0.0 after Iteration 1 (case with more centers than non-duplicate samples / duplicate points in X).",
        "buggy_output": "Initialization complete\nIteration 0, inertia 40.0.\nIteration 1, inertia 0.0.\nIteration 2, inertia 0.0.\n...\nIteration 297, inertia 0.0.\nIteration 298, inertia 0.0.\nIteration 299, inertia 0.0.",
        "expected_output": "Initialization complete\nIteration 0, inertia 40.0.\nIteration 1, inertia 0.0.",
        "value_kind": "string",
        "source": "issue:issue#28055"
      }
    ],
    "oracle_clues": [
      "\u201cIn your case, Kmeans stopped at 300\u2026 default value for max_iterations is 300.\u201d",
      "\u201cI believe Kmeans should stop in the second iteration because inertia is 0.0\u201d",
      "Expected results show only: \u201cInitialization complete / Iteration 0, inertia 40.0. / Iteration 1, inertia 0.0.\u201d",
      "Actual results show repeated iterations with \u201cinertia 0.0\u201d continuing past Iteration 1 when max_iter is very large.",
      "PR body states the cause: \u201crelocation of empty cluster will trigger at every iteration preventing the algorithm to stop.\u201d"
    ]
  },
