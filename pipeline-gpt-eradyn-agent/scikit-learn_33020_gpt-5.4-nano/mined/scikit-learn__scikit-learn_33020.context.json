    "trigger_conditions": [
      "Using sklearn.linear_model.RidgeCV with gcv_mode=\"svd\"",
      "Using very small alpha values (1e-14 or less; e.g. alphas=[1e-15, 1e-14])",
      "Noiseless data from make_regression with noise=0",
      "After fitting on X_train and scoring on X_test in the described train/test split (test_size=0.9, random_state=42)"
    ],
    "input_output_examples": [
      {
        "input": "alphas=[1e-15, 1e-14]; RidgeCV(alphas=alphas, gcv_mode=\"svd\").fit(X_train, y_train); score = ridge_cv.score(X_test, y_test) (with make_regression(n_samples=1000, n_features=50, noise=0, random_state=42) and train_test_split(test_size=0.9, random_state=42))",
        "buggy_output": "score=-37754.60; min_coef=-9221.16; max_coef=11981.91",
        "expected_output": "score=1.00 (as in the example where gcv_mode=\"eigen\" gives perfect fit); min_coef=-0.00; max_coef=94.78",
        "value_kind": "float",
        "source": "issue:issue#32459 Expected/Actual Results"
      }
    ],
    "oracle_clues": [
      "The issue provides concrete expected results for gcv_mode=\"eigen\": score=1.00, min_coef=-0.00, max_coef=94.78.",
      "The issue provides concrete actual results for gcv_mode=\"svd\" with alphas=[1e-15, 1e-14]: score=-37754.60, min_coef=-9221.16, max_coef=11981.91.",
      "Correctness is judged by the RidgeCV score (and coefficient magnitudes) matching the expected near-perfect fit in the noiseless case."
    ]
