      "The sign reported by log_det.sign_from_args is checked for such inputs"
    ],
    "input_output_examples": [
      {
        "input": "log_det applied to X = 0.5*I (log(det(X)) < 0)",
        "buggy_output": "sign reported as nonnegative (exact buggy tuple not stated in passages)",
        "expected_output": "(False, False)",
        "value_kind": "boolean",
        "source": "pr_body:PR#3180 and commit message: log_det.sign_from_args incorrectly claimed log(det(X)) is always nonneg; changed to (False, False)"
      }
    ],
