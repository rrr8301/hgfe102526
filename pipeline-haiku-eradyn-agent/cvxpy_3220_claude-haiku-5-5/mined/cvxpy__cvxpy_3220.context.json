  "numerical_failure": {
    "category": "correctness",
    "affected_api": "cvxpy.reductions.eliminate_pwl.canonicalizers.sum_largest_canon.sum_largest_canon",
    "observed_behavior": "The DNLP warm-start for sum_largest sets q to max(k smallest) instead of the k-th largest threshold, and initializes t only for the top-k elements. Middle elements with x_i > q therefore violate x_i <= t_i + q, so the warm start is infeasible.",
    "expected_behavior": "The warm start should be feasible: q.value should be min(x.value[idx_of_largest]), the k-th largest element, and t.value should be np.maximum(0, x.value - q.value) for all elements, so that x_i <= t_i + q and t_i >= 0 hold for every element.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "x.value is not None when the DNLP warm-start canonicalization runs",
      "some elements of x lie between q and the top-k (middle elements with x_i > q)",
      "solver is an NLP solver (e.g. IPOPT or Knitro) starting from the warm start"
    ],
    "input_output_examples": [
      {
        "input": "x = [1, 10, 6, 8, 3, 9] with k=2",
        "buggy_output": "q = 3"
      }
    ],
    "oracle_clues": [
      "regression tests check that q and t are computed correctly",
      "tests assert constraints x_i <= t_i + q and t_i >= 0 hold for all elements, including middle ones",
      "the regression test was added in commit e9cf9f4 in PR#3220"
    ]
  },
  "numerical_characteristics": {
    "dtype": null,
    "precision": null,
    "magnitude": null,
    "tolerance": null,
    "category_specific_evidence": [
      "Epigraph form of sum_k_largest(x) requires constraints x_i <= t_i + q and t_i >= 0 for all elements, per PR body and test description.",
      "Bug: q was set to max of k smallest elements instead of min of k largest elements (commit message: 'q was set to max(k smallest) instead of min(k largest)').",
      "Bug: t was only initialized for top-k elements, so middle elements with x_i > q violate x_i <= t_i + q, producing an infeasible DNLP warm start.",
      "Fix: q = min(x[top-k]) and t = max(0, x - q) for all elements (commit message and PR body).",
      "Regression test example: x = [1, 10, 6, 8, 3, 9] with k=2; top-2 are {10, 9}; middle elements 6 and 8 triggered the bug; test checks x_i <= t_i + q and t_i >= 0 for all elements.",
      "Objective of canonicalization is sum(t) + k*q, as stated in the test comment.",
      "Diff changed idx_of_smallest = sorted_indices[:k] to sorted_indices[:-k] in sum_largest_canon.py."
    ],
    "reproduction_risks": [
      "The passages do not state a dtype or numeric precision for the values.",
      "The passages do not state a numerical tolerance used in the feasibility checks.",
      "Commit and PR descriptions differ on the final fix (PR body says q = np.min(x.value[idx_of_largest]) and removes idx_of_smallest; the diff shows idx_of_smallest changed to sorted_indices[:-k]), so the exact final code path is ambiguous."
    ]
  },
