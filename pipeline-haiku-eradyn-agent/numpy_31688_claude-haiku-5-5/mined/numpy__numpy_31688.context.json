    "tolerance": null,
    "category_specific_evidence": [
      "Signed integer overflow in days_to_yearsdays in numpy/_core/src/multiarray/datetime.c:171:31 when computing (*days_) - (365*30 + 7) for datetime64 values near INT64_MIN, flagged by UndefinedBehaviorSanitizer",
      "UBSan message: -9223372036854775807 - 10957 cannot be represented in type 'npy_int64'",
      "Reproducer: np.datetime64(np.iinfo(np.int64).min + 1, 'D').item() triggers the overflow",
