+def test_nan_is_not_missing_without_nan_like_na(dt):
+    arr = np.array([np.nan, 1.5], dtype="float32").astype(dt)
+    assert arr[0] == "nan"
+    assert arr[1] == "1.5"
+    arr = np.array([complex(np.nan, 2.0), complex(0.0, np.nan)],
