    ],
    "input_output_examples": [
      {
        "input": "df with columns ['year','month','day','hour','minute','second'] built from integer rows such as [2024, 1, 7, 11, 42, 13]; ts32 = pd.to_datetime(df.astype('float32'), utc=True)",
        "buggy_output": "ts32 differs from ts (print(ts - ts32) shows nonzero differences)",
        "expected_output": "ts32 equal to ts and ts64 (ts.equals(ts32) is True)",
        "value_kind": "property",
        "source": "issue#60506 reproducer"
      }
    ],
    "oracle_clues": [
      "assert ts.equals(ts64)",
      "assert ts.equals(ts32)",
      "print(ts - ts32) shows the discrepancy",
