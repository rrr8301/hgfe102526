  "numerical_failure": {
    "category": "accuracy",
    "affected_api": "pandas._libs.window.aggregations.calc_skew",
    "observed_behavior": "Rolling skew and kurtosis lose precision and can give wrong values on windows with tiny scale or large magnitude relative to spread. The old raw-moment computation (sums x, xx, xxx, with B = xx/n - A*A) suffers catastrophic cancellation, so floating error can leave B nonzero for degenerate windows, producing a very large number instead of NaN. Windows polluted by outliers also give unreliable skew.",
    "expected_behavior": "For degenerate windows whose variance is negligible, the result should be NaN rather than a very large number. The new check is m2 < dnobs * (1e-28 * mean * mean if fabs(mean) > 1e-14 else 1e-14), and the result is then NaN.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "degenerate"
    ],
    "input_output_examples": [],
    "oracle_clues": []
  },
  "numerical_characteristics": {
    "dtype": "float64",
    "precision": "A change in 10 significant digits in base 10 was proposed as the catastrophic-cancellation criterion; the discussion also mentions double-double as the upper bound of needed precision.",
    "magnitude": "Large float64 values, where multiplying two of them causes over/underflow (Pearson correlation via Welford), and where |A| + |B| >> |A - B| causes cancellation.",
    "tolerance": "A 1e10 threshold is referenced in a discussion question; the code uses InvCondTol (renamed from IncConditionNumber), but its value is not stated in the passages.",
    "category_specific_evidence": [
      "Code check: if (fabs(m3_update) + fabs(m3[0])) * InvCondTol > fabs(new_m3) sets numerically_unstable[0] = True, flagging possible catastrophic cancellation in the 3rd central moment update.",
      "Discussion: losing significant digits when |A| + |B| >> |A - B| was the basis for treating a 10-significant-digit change as catastrophic cancellation.",
      "Degenerate/uniform windows: floating-point artif"
    ],
    "reproduction_risks": []
  },
