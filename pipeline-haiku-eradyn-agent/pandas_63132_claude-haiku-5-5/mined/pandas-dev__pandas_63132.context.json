  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas._libs.groupby.group_sum",
    "observed_behavior": "When a float group sum overflows, groupby sum returns NaN instead of infinity. With s = pd.Series([1.797693e+308, 1.797693e+308, 1.797693e+308]), s.groupby([1, 1, 1]).sum() gives NaN for group 1, while s.groupby([1, 1, 1]).apply(lambda _grp: _grp.sum()) gives inf. DataFrame.resample('1min').agg(col=('col','sum')) also gives NaN on the same overflowing data.",
    "expected_behavior": "The overflowing float sum should return inf (or -inf for negative overflow), consistent with pure Python sum and numpy.sum, and with the groupby apply path.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "float overflow occurs during a groupby sum aggregation (group_sum)",
      "the group values are large floats, e.g. three values of 1.797693e+308 (near float64 max) summed in one group",
      "the Kahan compensation term becomes non-finite (NaN) when the value is +/- infinity, which turns the result into NaN instead of +/- infinity",
      "applies to float32/float64 sums; the fix handles complex overflow separately"
    ],
    "input_output_examples": [
      {
        "input": "s = pd.Series([1.797693e+308, 1.797693e+308, 1.797693e+308]); s.groupby([1, 1, 1]).sum()",
        "buggy_output": "NaN",
        "expected_output": "inf",
        "value_kind": "float",
        "source": "issue#60303"
      },
      {
        "input": "s = pd.Series([1.797693e+308, 1.797693e+308, 1.797693e+308]); s.groupby([1, 1, 1]).apply(lambda _grp: _grp.sum())",
        "buggy_output": "inf",
        "expected_output": "inf",
        "value_kind": "float",
        "source": "issue#60303"
      }
    ],
    "oracle_clues": [
      "Issue states expected behaviour is to return infinity (or -infinity) on overflow, matching pure python sum and numpy.sum which both return"
    ]
  },
  "numerical_characteristics": {
    "dtype": "float64",
    "precision": null,
    "magnitude": "Overflow near np.finfo(np.float64).max (1.7976931348623157e+308); three such values summed in group_sum produce NaN instead of inf",
    "tolerance": null,
    "category_specific_evidence": [
      "Issue #60303 reports that a sum aggregation overflowing during resample/groupby returns NaN instead of inf, contradicting pure Python sum and numpy.sum which return inf.",
      "Maintainer comment attributes the bug to Kahan summation compensation: when val is +/- infinity the compensation becomes NaN, so results become NaN instead of +/- infinity.",
      "Test test_cython_group_sum_overflow (GH-60303) uses np.finfo(np.float64).max as input and expects np.inf for the sum; the test note says it requires 3 values to trigger NaN.",
      "Test cases include complex128 input np.finfo(np.float64).max + 3j expected as complex(np.inf, 9.0) for the same overflow scenario.",
      "Fix checks isfinite on compensation for float32/float64 and on compensation real part for complex64/complex128, resetting compensation to 0 when non-finite."
    ],
    "reproduction_risks": [
      "Commit message and fix references GH#60303; the reported environment was Python 3.11.9 on Windows with pandas commit 0691c5cf90477d3503834d983f69350f250a6ff7.",
      "Expected result is +/- inf for overflow; reproduction should use group_sum with three values in one group (labels all 0)."
    ]
  },
