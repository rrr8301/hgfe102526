  "numerical_failure": {
    "category": "accuracy",
    "affected_api": "pandas.core.window.rolling.Rolling.corr and pandas.core.window.rolling.Rolling.cov (rolling window correlation/covariance, backed by pandas/_libs/window/aggregations.pyx)",
    "observed_behavior": "Rolling correlation returns inf instead of nan for a constant window; rolling cov result (v1) differs from the non-rolling cov (v2) because the rolling implementation was numerically unstable.",
    "expected_behavior": "Rolling corr should match Series.corr (c1 == c2) and rolling cov should match Series.cov (v1 == v2); a constant sequence with zero standard deviation should yield nan rather than inf.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "Rolling window containing a constant sequence (zero standard deviation), e.g. b = [9.45]*5 correlated against a series with a large value such as 1e5",
      "Rolling corr/cov computed over windows with large dynamic range values, leading to numerical instability in the online update of co-moments"
    ],
    "input_output_examples": [
      {
        "input": "a = pd.Series([1e5, 0, 0, 0, 0]); b = pd.Series([9.45] * 5); a.rolling(5).corr(b).iloc[4] vs a.corr(b)",
        "buggy_output": "rolling corr c1 is inf",
        "expected_output": "nan (same as a.corr(b), c1 == c2)",
        "value_kind": "float",
        "source": "issue#24019"
      },
      {
        "input": "a = pd.Series([1e5, 0, 0, 0, 0]); b = pd.Series([9.45] * 5); a.rolling(5).cov(b).iloc[4] vs a.cov(b)",
        "buggy_output": "v1 differs from v2",
        "expected_output": "v1 == v2 (equal to a.cov(b))",
        "value_kind": "float",
        "source": "issue#24019"
      }
    ],
    "oracle_clues": [
      "assert c1 == c2",
      "assert v1 == v2",
      "Expected Output: assertions pass"
    ]
  },
