  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas.core.arrays.timedeltas.TimedeltaArray._from_sequence",
    "observed_behavior": "Float and mixed int/float input given with a timedelta64[unit] dtype is treated as nanoseconds and then cast to the coarser unit, so the values silently truncate to zero (e.g. 90 seconds lost, all 0 days).",
    "expected_behavior": "Numeric input (float, mixed int/float, and input with missing values) is interpreted in the dtype's unit, e.g. seconds for timedelta64[s], matching to_timedelta(..., unit=...).",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "Series, DataFrame, or pd.array constructed with a timedelta64[unit] dtype such as timedelta64[s]",
      "Input is float-valued numeric data, or a mix of integers and floats",
      "Before the fix, integer-only input was already honored and float or mixed input was not"
    ],
    "input_output_examples": [
      {
        "input": "pd.Series([1.5, 2.5, 90.0], dtype=\"timedelta64[s]\")",
        "buggy_output": ""
      }
    ],
    "oracle_clues": []
  },
  "numerical_characteristics": {
    "dtype": "timedelta64[s]",
    "precision": null,
    "magnitude": "values such as 1.5, 2.5, 90.0 seconds; 90 seconds is lost (truncated to 0 days) under nanosecond interpretation",
    "tolerance": null,
    "category_specific_evidence": [
      "pd.Series([1.5, 2.5, 90.0], dtype=\"timedelta64[s]\") produced all 0 days (90s lost) before the fix, because float input was treated as nanoseconds and cast down to coarser resolution, silently truncating to zero",
      "pd.Series([1, 2.5, 90], dtype=\"timedelta64[s]\") produced all 0 days before the fix (mixed int/float)",
      "pd.Series([1, 2, 3], dtype=\"timedelta64[s]\") gives 1s/2s/3s and was already correct for integer input",
      "Expected property: float and mixed int/float values should be interpreted in the dtype's unit (seconds), matching pd.to_timedelta(data, unit=\"s\").as_unit(\"s\")",
      "Test expects Series([1.5, 2.5, 90.0], dtype=\"timedelta64[s]\") to equal Series(pd.to_timedelta(data, unit=\"s\").as_unit(\"s\")) for data [1.5,2.5,90.0], [1,2.5,90], [1.5,NaT,90]",
      "Array-level test expects np.array([1.5, np.nan, 90.0]), Float64 masked array, [1.5, pd.NA, 90.0] and [1.5, None, 90.0] with dtype m8[s] to match TimedeltaArray from [1, 'NaT', 90] m8[s]",
      "Fix replaces infer_dtype string check with dtype-based dispatch and promotes lib.is_integer_float_array from cdef to cpdef"
    ],
    "reproduction_risks": [
      "PR body states known corners were left pre-existing and the text is truncated, so the full list of excluded cases is not available",
      "Passage does not state a numerical tolerance for comparisons; the tests use exact equality via assert_series_equal and assert_extension_array_equal",
      "Exact precision and magnitude bounds beyond the quoted example values are not stated",
      "The reproducer for the original bug uses value 90.0 in seconds; the expected output after fix is stated only qualitatively for the float case"
    ]
  },
