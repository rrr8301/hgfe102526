  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas._libs.tslibs.timedeltas._binary_op_method_timedeltalike",
    "observed_behavior": "Timedelta.__add__/__radd__/__sub__/__rsub__ with a timedelta64 ndarray handed the operation to numpy, so an out-of-bounds sum silently wrapped, the promotion to the finer unit wrapped, and a sum landing exactly on iNaT came back as NaT. Example: Timedelta.min + np.array([-1], 'm8[ns]') returns array(['NaT'], dtype='timedelta64[ns]'); Timedelta.min + np.array([-2], 'm8[ns]') returns array([9223372036854775807], dtype='timedelta64[ns]'); Timedelta(10**12, 's') + np.array([1], 'm8[ns]') returns array([3875820019684212737], dtype='timedelta64[ns]').",
    "expected_behavior": "The out-of-bounds sum, the unit promotion overflow, and a sum landing on the NaT sentinel should raise OutOfBoundsTimedelta, matching the scalar Timedelta and TimedeltaIndex operations.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "Timedelta scalar added to or subtracted from a timedelta64 ndarray (including reflected operations)",
      "sum overflows int64 range",
      "sum lands exactly on iNaT sentinel",
      "operand unit is finer than the Timedelta unit, causing promotion that overflows (e.g. seconds to nanoseconds)"
    ],
    "input_output_examples": [
      {
        "input": "Timedelta.min + np.array([-1], 'm8[ns]')",
        "buggy_output": "array(['NaT'], dtype='timedelta64[ns]')",
        "expected_output": "raise OutOfBoundsTimedelta",
        "value_kind": "exception",
        "source": "pr_body:PR#66661"
      },
      {
        "input": "Timedelta.min + np.array([-2], 'm8[ns]')",
        "buggy_output": "array([9223372036854775807], dtype='timedelta64[ns]')",
        "expected_output": "raise OutOfBoundsTimedelta",
        "value_kind": "exception",
        "source": "pr_body:PR#66661"
      },
      {
        "input": "Timedelta(10**12, 's') + np.array([1], 'm8[ns]')",
        "buggy_output": "array([3875820019684212737], dtype='timedelta64[ns]')",
        "expected_output": "raise OutOfBoundsTimedelta",
        "value_kind": "exception",
        "source": "pr_body:PR#66661"
      }
    ],
    "oracle_clues": [
      "Expected behavior is raising OutOfBoundsTimedelta, as the scalar Timedelta and TimedeltaIndex operations already do",
      "Reproducer from PR#66661 kept whole in PR body",
      "Issue GH#66552 referenced in whatsnew and commits"
    ]
  },
  "numerical_characteristics": {
    "dtype": "timedelta64 (m8), with examples m8[ns] and m8[s]",
    "precision": null,
    "magnitude": "Timedelta.min with int64 overflow near 2**63-1; example 10**12 seconds promoted to ns; 1M-element arrays in performance note",
    "tolerance": null,
    "category_specific_evidence": [
      "Timedelta.min + np.array([-1], 'm8[ns]') returned NaT because the sum equals iNaT (int64 min sentinel), though the sum fits in int64",
      "Timedelta.min + np.array([-2], 'm8[ns]') returned 9223372036854775807, i.e. wrapped past int64 bounds",
      "Timedelta(10**12, 's') + np.array([1], 'm8[ns]') returned 3875820019684212737, wrapped during the s-to-ns unit promotion",
      "Expected behavior per commit: out-of-bounds sums should raise OutOfBoundsTimedelta (message 'Out of bounds {unit} timedelta') rather than wrap or become NaT, matching scalar Timedelta and TimedeltaIndex behavior",
      "Fix routes Timedelta +/- timedelta64 ndarray through add_overflowsafe/astype_overflowsafe, casting to finer unit like numpy but raising on overflow",
      "Test test_td_add_sub_td64_ndarray_lands_on_nat_sentinel checks td_min - one, td_min + (-one), (-one) + td_min and __rsub__ from td_max raise OutOfBoundsTimedelta",
      "Year/month units (Y, M) are left to numpy, which raises TypeError 'Cannot get a common metadata divisor'"
    ],
    "reproduction_risks": [
      "Numpy deprecates the generic timedelta unit in numpy 2.6.0.dev0, so reproducers should give NaT an explicit unit",
      "Performance cost: add_overflowsafe is about 5x slower on 1M elements (1.28 ms to 6.05 ms) per PR body"
    ]
  },
