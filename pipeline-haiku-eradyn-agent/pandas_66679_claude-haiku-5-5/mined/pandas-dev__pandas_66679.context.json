  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas._libs.tslibs.offsets.Day._apply_array",
    "observed_behavior": "For a tz-aware DatetimeIndex, adding a Day offset whose result lands on the NaT sentinel returns a missing value (NaT), and an out-of-bounds result silently wraps to an unrelated date (e.g. 2262-04-10) instead of raising OverflowError as the tz-naive path does.",
    "expected_behavior": "Out-of-bounds or sentinel-landing results should raise OverflowError, matching the tz-naive behaviour, e.g. dti + pd.offsets.Day(-1) raises OverflowError; in-bounds results and NaT propagation are unchanged.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "Day offset added to a tz-aware DatetimeIndex (or Series) whose result lands on the NaT sentinel or goes out of int64 bounds",
      "Day offset with n large enough to overflow int64 during unit conversion to the array's unit"
    ],
    "input_output_examples": [
      {
        "input": "dti = pd.DatetimeIndex([pd.Timestamp(iNaT + 86400 * 10**9)]); dti.tz_localize('UTC') + pd.offsets.Day(-1)",
        "buggy_output": "NaT",
        "expected_output": "OverflowError",
        "value_kind": "exception",
        "source": "pr_body:PR#66679"
      },
      {
        "input": "dti.tz_localize('UTC') + pd.offsets.Day(-2)",
        "buggy_output": "2262-04-10",
        "expected_output": "OverflowError",
        "value_kind": "exception",
        "source": "pr_body:PR#66679"
      },
      {
        "input": "dti + pd.offsets.Day(-1)  (tz-naive)",
        "buggy_output": "OverflowError",
        "expected_output": "OverflowError",
        "value_kind": "exception",
        "source": "pr_body:PR#66679"
      }
    ],
    "oracle_clues": [
      "Tz-naive path already raises OverflowError and is the reference behaviour",
      "Fix mirrors Week._apply_array using checked_mul and add_overflowsafe, raising OverflowError('Overflow in int64 addition')",
      "Changelog entry references GH#66552 in doc/source/whatsnew/v3.1.0.rst"
    ]
  },
  "numerical_characteristics": {
    "dtype": "datetime64 tz-aware (tz_localize('UTC')); tests also parametrize tz-naive datetime64 with units 's' and 'ns'",
    "precision": "Reproducer and PR examples use ns resolution (86400*10**9 per day); the parametrized test uses unit 's' (86400 per day) and 'ns'",
    "magnitude": "Sum equals the iNaT sentinel (int64 minimum) exactly, or lies one day past the end of the int64 range; n=2**60 overflows int64 during unit conversion",
    "tolerance": null,
    "category_specific_evidence": [
      "Correct behavior is OverflowError with message 'Overflow in int64 addition' when a Day shift leaves the valid range or lands on the NaT sentinel, matching the tz-naive path that already raises.",
      "Reproducer: dti=DatetimeIndex([Timestamp(iNaT + 86400*10**9)]); dti.tz_localize('UTC') + Day(-1) returns NaT silently (should raise OverflowError).",
      "Reproducer: dti.tz_localize('UTC') + Day(-2) returns 2262-04-10 silently (wrapped to an unrelated date; should raise OverflowError).",
      "The tz-naive dti + Day(-1) already raises OverflowError, which is the reference behavior.",
      "Fix: n is converted to the array's unit with checked_mul(self._n, periods_per_day(reso)); a result equal to NPY_NAT is rejected; the addition uses add_overflowsafe instead of raw numpy add.",
      "Test test_dt64arr_add_day_lands_on_nat_sentinel expects OverflowError for Day(-1) on data at iNaT+per_day, and for Day(2**60) with match 'Overflow in int64 addition'"
    ],
