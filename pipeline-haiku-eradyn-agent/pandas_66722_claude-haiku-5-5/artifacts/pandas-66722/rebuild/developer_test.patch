+                check_dtype=False,
+                check_exact=False,
+                rtol=0.5 / 2**60,
+                atol=0,
+            )
+    _assert_series_equal_both(
+        left,
+        right,
+        check_dtype=False,
+        check_exact=False,
+        rtol=1 / 2**60,
+        atol=0,
+    )
+
