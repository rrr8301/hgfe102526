  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas.Series.convert_dtypes",
    "observed_behavior": "convert_dtypes raises OverflowError with message 'Python int too large to convert to C long' for object-dtype integers outside the int64 range, because the object branch maps integer-inferred data to Int64 without checking that the values fit (IntegerArray._safe_cast overflows).",
    "expected_behavior": "convert_dtypes should leave the column as object dtype when the values do not fit the target integer dtype, matching the dtype that Series construction already infers (dtype('O')). Signed/unsigned conflicts such as [2**63, -1] should also retain object. [2**63, pd.NA] should give UInt64, matching [2**63].",
    "manifestation": "exception",
    "trigger_conditions": [
      "object-dtype Series holding Python integers outside the int64 range, e.g. 2**64 or -(2**63) - 1",
      "convert_dtypes run with infer_objects=True, the only path where the object branch executes",
      "signed/unsigned integer conflicts in object data, e.g. [2**63, -1]",
      "applies under both dtype backends"
    ],
    "input_output_examples": [
      {
        "input": "pd.Series([2**64], dtype=object).convert_dtypes()",
        "buggy_output": "OverflowError: Python int too large to convert to C long",
        "expected_output": "dtype('O')",
        "value_kind": "string",
        "source": "issue#66517 reproducer and expected behavior"
      },
      {
        "input": "pd.Series"
      }
    ],
    "oracle_clues": []
  },
  "numerical_characteristics": {
    "dtype": "object",
    "precision": null,
    "magnitude": "Integers outside the int64 range, e.g. 2**64, -(2**63) - 1, 10**400, and signed/unsigned conflicts such as [2**63, -1]",
    "tolerance": null,
    "category_specific_evidence": [
      "Issue#66517 reproducer: pd.Series([2**64], dtype=object).convert_dtypes() raises OverflowError: Python int too large to convert to C long",
      "Issue#66517 reproducer also raises OverflowError for pd.Series([-(2**63) - 1], dtype=object).convert_dtypes()",
      "Issue#66517 reproducer output shows dtype('O') as the expected result for pd.Series([2**64], dtype=object).convert_dtypes().dtype",
      "Expected property: out-of-range integers should retain object dtype since no int64/uint64 dtype holds them (test comment GH#66517)",
      "Test cases expect out-of-range values [2**64], [-(2**63) - 1], [10**400], [2**63, -1], [2**64, pd.NA] to return unchanged object Series",
      "Expected behavior: [2**63, pd.NA] gives UInt64 and [2**63, pd.NA] with 2**62 gives Int64, matching the non-NA equivalents",
      "PR#66791 notes the fix retains object under both dtype backends, matching what construction already infers",
      "Related issue#66519: dtype inference from object data raising OverflowError instead of inferring object for integers outside float64 range"
    ],
    "reproduction_risks": [
      "Pyarrow backend test (dtype_backend=\"pyarrow\") is skipped if pyarrow is not installed",
      "The exact expected dtype for the pyarrow backend is only stated as unchanged object via tm.assert_series_equal, not an explicit dtype value"
    ]
