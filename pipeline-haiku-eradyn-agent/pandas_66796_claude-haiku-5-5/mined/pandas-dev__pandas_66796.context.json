  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas.Series.to_json",
    "observed_behavior": "Serializing an object-dtype Series holding an unsigned numpy scalar above int64 max wraps the value to a negative number, e.g. '{\"0\":-9223372036854775808}'.",
    "expected_behavior": "The exact unsigned value should be written as decimal digits, e.g. '{\"0\":9223372036854775808}'.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "Series holds a numpy unsigned scalar (np.uint64 or np.ulonglong) in an object-dtype container",
      "The unsigned value is greater than INT64_MAX (2**63 - 1)",
      "The value is cast to int64 by the ujson encoder path instead of being routed to JT_BIGNUM",
      "Control: the same value in a real dtype=\"uint64\" Series already serializes correctly, and a plain Python int in object dtype is also correct"
    ],
    "input_output_examples": [
      {
        "input": "pd.Series([np.uint64(2**63)], dtype=object).to_json()",
        "buggy_output": "'{\"0\":-9223372036854775808}'",
        "expected_output": "'{\"0\":9223372036854775808}'",
        "value_kind": "string",
        "source": "issue#66142 reproducer and PR#66796 before/after"
      }
    ],
    "oracle_clues": [
      "The issue states the expected output as '{\"0\":9223372036854775808}', compared as text",
      "The uint64-dtype Series output '{\"0\":9223372036854775808}' is cited as the correct reference behaviour",
      "The fix routes values above INT64_MAX to JT_BIGNUM, which writes the exact decimal digits; values that fit keep the JT_LONG path"
    ]
  },
  "numerical_characteristics": {
    "dtype": "object",
    "precision": "exact decimal digits via JT_BIGNUM for unsigned scalars above INT64_MAX; uint8/uint16/uint32 unchanged via JT_LONG fast path",
    "magnitude": "values above int64 max (2**63 = 9223372036854775808)",
    "tolerance": null,
    "category_specific_evidence": [
      "Series([np.uint64(2**63)], dtype=object).to_json() returns '{\"0\":-9223372036854775808}' (wrapped negative) before fix",
      "After fix the same call returns '{\"0\":9223372036854775808}'",
      "Same input with dtype uint64 returns '{\"0\":9223372036854775808}' already correct",
      "Mathematical property violated: a non-negative unsigned value above INT64_MAX is wrapped to a negative number (value 2**63 is encoded as -2**63, i.e. value minus 2**64 modulo wrap)",
      "np.ulonglong (NPY_ULONGLONG, num=10) is a distinct type from np.uint64 (NPY_ULONG, num=8); issubclass(np.ulonglong, np.uint64) is False while issubclass(np.ulonglong, np.unsignedinteger) is True, so gating on uint64 spelling misses ulonglong",
      "Real uint64 arrays were not affected because PyArray_GETITEM yields Python int which takes JT_BIGNUM path; plain Python int in object dtype also fine",
      "test_int_max previously skipped uint64 max and used int64 max; changed to num = klass(np.iinfo(dtype).max) so uint64 max is round-tripped"
    ],
    "reproduction_risks": [
      "Reproducer requires object-dtype container holding a NumPy unsigned scalar, not a Python int or uint64 array",
      "np.ulonglong must be tested separately from np.uint64 on platforms where NPY_UINT64 aliases NPY_ULONG",
      "Python-level test uses ujson_loads/ujson_dumps round trip through klass(...) to compare against the original value"
    ]
  },
