    "trigger_conditions": [
      "one operand is an empty interval with left == right and closed not 'both', e.g. Interval(0, 0, closed='left') or Interval(0, 0, closed='right') or Interval(0, 0, closed='neither')",
      "the other operand is a closed interval containing the point 0, e.g. Interval(0, 1, closed='both') or Interval(-1, 1, closed='both')"
    ],
    "input_output_examples": [
      {
        "input": "pd.Interval(0, 1, \"both\").overlaps(pd.Interval(0, 0, \"right\"))",
