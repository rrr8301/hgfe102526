  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas.core.dtypes.cast.convert_dtypes",
    "observed_behavior": "pd.Series([2.0**63]).convert_dtypes() returned Int64 holding 9223372036854775807 (one less than the true value); values like 1e30 and inf raised a spurious RuntimeWarning before correctly falling back to Float64",
    "expected_behavior": "A float equal to 2**63 must not be converted to Int64 with a saturated value; out-of-int64-range floats should fall back to Float64 without a spurious RuntimeWarning",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "convert_dtypes on float data whose values are outside the int64 range, e.g. 2.0**63",
      "float values such as 1e30 or inf passed to convert_dtypes, which emit a spurious RuntimeWarning",
      "Series.loc/DataFrame.loc setitem-with-expansion calling floats_fit_integer_dtype with a narrower float16 array also emitted the spurious warning before the fix"
    ],
    "input_output_examples": [
      {
        "input": "pd.Series([2.0**63]).convert_dtypes()",
        "buggy_output": "Int64 holding 9223372036854775807",
        "expected_output": "Float64 (value 2**63 must not be saturated to int64 max)",
        "value_kind": "property",
        "source": "pr_body"
      },
      {
        "input": "pd.Series([1e30]).convert_dtypes() (and inf)",
        "buggy_output": "spurious RuntimeWarning before falling back to Float64",
        "expected_output": "Float64 with no RuntimeWarning",
        "value_kind": "exception",
        "source": "pr_body"
      }
    ],
    "oracle_clues": [
      "Spurious RuntimeWarning is the warning form of the failure",
      "Expected Int64 result must equal the true value; saturated value 9223372036854775807 is one less than 2**63",
      "Fix guards call sites with floats_fit_integer_dtype before the (arr.astype(int) == arr).all() check",
      "Helper bounds use np.float64 scalars so float16 widens to float64 instead of overflowing to inf"
    ]
  },
  "numerical_characteristics": {
    "dtype": "float16",
    "precision": null,
    "magnitude": "int64 range bounds; values 2.0**63, 1e30, inf, -inf, float(INT_MAX+1)",
    "tolerance": null,
    "category_specific_evidence": [
      "convert_dtypes casting float to int used (arr.astype(int) == arr).all() without range check; astype(int) silently saturates out-of-range floats",
      "pd.Series([2.0**63]).convert_dtypes() returned Int64 holding 9223372036854775807, one less than the true value 2**63",
      "values 1e30 and inf raised a spurious RuntimeWarning before falling back to Float64",
      "float(INT_MAX+1) == INT_MAX after saturating cast, letting an off-by-one Int64 value through",
      "fix uses np.float64 scalar bounds so float16 values promote to float64 instead of bounds overflowing to inf",
      "float16 int64-bound downcast overflowed to inf causing spurious RuntimeWarning in maybe_downcast_numeric and setitem-with-expansion",
      "tests: test_convert_dtypes_float_out_of_int64_range with [1e30],[inf],[-inf] expecting Float64; test_convert_dtypes_float_one_past_max expecting Float64; most negative float(iinfo.min) expecting Int64",
      "test_downcast_float16_no_overflow_warning expects [1,2] int64 with RuntimeWarning as error"
    ],
    "reproduction_risks": [
      "Platform-dependent C int width: test takes bounds from np.iinfo(np.dtype(int))",
      "Spurious RuntimeWarning must be treated as error to detect the bug",
      "Setitem-with-expansion case: ser.loc[2]=np.float16(3.0) on int64 Series expects int64 result [1,2,3]"
    ]
  },
