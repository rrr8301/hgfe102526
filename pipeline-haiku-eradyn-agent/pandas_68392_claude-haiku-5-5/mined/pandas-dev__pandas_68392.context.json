    "trigger_conditions": [
      "The Timedelta has a zero value (self._value == 0)",
      "The multiplier is a float infinity (float inf)",
      "Scalar Timedelta.__mul__ path, not the vectorized TimedeltaIndex, timedelta64 Series or ndarray paths, which already return NaT"
    ],
    "input_output_examples": [
      {
        "input": "Timedelta(0) * float('inf')",
        "buggy_output": "ValueError: cannot convert float NaN to integer",
        "expected_output": "NaT",
        "value_kind": "property",
        "source": "commit/PR#68392 description: zero Timedelta multiplied by inf"
      }
    ],
    "oracle_clues": [
      "Regression test named test_td_mul_zero_by_inf_is_nat is referenced in the fix comment",
      "Fix returns NaT when isinstance(other, float) and isinf(other) and self._value == 0, mirroring _mul_numeric_array's NaN-to-NaT substitution",
      "Whatsnew entry cites issue GH-68392",
      "No tolerance applies; the expected result is the NaT sentinel"
    ]
  },
