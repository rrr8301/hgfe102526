    "category": "special_value",
    "affected_api": "pandas._libs.tslibs.timedeltas.Timedelta.__mul__",
    "observed_behavior": "Multiplying a zero Timedelta by an infinity raised ValueError: cannot convert float NaN to integer, because __mul__ cast the product straight to int64 and 0 * inf is NaN.",
