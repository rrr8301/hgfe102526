  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas.core.nanops.nanvar",
    "observed_behavior": "nanvar(values, axis=0, skipna=False, mask=mask) returns [nan, 4.0]; the explicit mask was honored only in the denominator (count/d) and zeroed in the squared-deviation sum, while the masked value still entered the mean.",
    "expected_behavior": "Under skipna=False an explicit mask marks NA, so the result propagates NA for the affected column: [nan, 2.0] by the NA-propagation reading (the mask-exclusion reading would give var([1, 3]) == 2 for the first column), with masked positions filled with NaN under skipna=False and 0 under skipna=True.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "explicit mask argument passed to nanvar (non-None mask)",
      "skipna=False",
      "values contain masked positions",
      "bool dtype input also affected because np.nan putmask would write True into a bool array"
    ],
    "input_output_examples": [
      {
        "input": "values = np.array([[1.0, 1.0], [np.nan, 2.0], [3.0, 3.0]]); mask = np.array([[False, False], [True, True], [False, False]]); nanops.nanvar(values, axis=0, skipna=False, mask=mask)",
        "buggy_output": "[nan, 4.0]",
        "expected_output": "NA-propagation: [nan, 2.0] for the second column per mask-exclusion reading var([1, 3]) == 2; first column nan under NA-propagation",
        "value_kind": "array",
        "source": "pr_body:PR#68464 reproducer"
      }
    ],
    "oracle_clues": [
      "PR body states NA-propagation says nan and mask-exclusion says var([1, 3]) == 2",
      "reproducer comment '# [nan, 4.0]' gives buggy output",
      "fix is a putmask of NaN under skipna=False, behaviour settled by GH-67068 for nansem"
    ]
  },
  "numerical_characteristics": {
    "dtype": "float64",
