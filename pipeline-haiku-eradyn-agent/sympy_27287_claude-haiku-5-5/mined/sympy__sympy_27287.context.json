    "manifestation": "exception",
    "trigger_conditions": [
      "input is a numpy floating value equal to positive or negative infinity, e.g. numpy.float32(float('inf'))",
      "passed to sympy.Float or sympify, which routes through _convert_numpy_types",
      "numpy installed; sympy==1.13.3, numpy==2.1.3, python 3.10.15 in the report"
    ],
    "input_output_examples": [
      {
        "input": "sympy.Float(np.float32(float('inf')))",
        "buggy_output": "OverflowError: cannot convert Infinity to integer ratio",
        "expected_output": "Float('inf')",
        "value_kind": "exception",
        "source": "issue#27284"
      },
      {
        "input": "sympify(np.float32('inf'))",
        "buggy_output": "OverflowError: cannot convert Infinity to integer ratio",
        "expected_output": "Float('inf')",
        "value_kind": "exception",
        "source": "PR#27287 release notes"
      }
    ],
    "oracle_clues": [
      "Traceback shows OverflowError raised from a.as_integer_ratio() in sympy/core/sympify.py _convert_numpy_types",
      "Fix returns Float('inf') for np.isposinf and Float('-inf') for np.isneginf before the ratio conversion",
      "Fix was added in PR#27287 for issue#27284"
    ]
