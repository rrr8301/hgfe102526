  "numerical_failure": {
    "category": "correctness",
    "affected_api": "cvxpy.atoms.matrix_frac.MatrixFrac._grad",
    "observed_behavior": "MatrixFrac._grad (used by Atom.grad) computes the gradient w.r.t. X using DX.T.ravel(order='F'), which is equivalent to DX.ravel(order='C') (row-major), producing silently wrong gradients whenever X has more than one column; errors up to ~0.97 before the fix. For vector X the transpose is a no-op and the bug is masked.",
    "expected_behavior": "The gradient w.r.t. X, (P^-1 + P^-T)X, should be vectorized in Fortran (column-major) order per CVXPY convention, i.e. DX.ravel(order='F') without the .T. After the fix the max finite-difference error is ~1.85e-08.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "matrix_frac atom with matrix X of shape (n, p) where p > 1",
      "gradient computed via Atom.grad (problem.backward() and problem.derivative() are not affected)",
      "vector X (single column) masks the bug"
    ],
    "input_output_examples": [
      {
        "input": "matrix_frac with matrix X of shape (n, p), p > 1; Atom.grad call",
        "buggy_output": "gradient with errors up to ~0.97 relative to finite-difference check",
        "expected_output": "gradient matching finite-difference check with max error ~1.85e-08",
        "value_kind": "array",
        "source": "pr_body:PR#3247"
      }
    ],
    "oracle_clues": [
      "Finite-difference check comparing gradients (max error ~1.85e-08 after fix vs ~0.97 before)",
      "Unit tests were written and run per PR checklist (no specific test named)"
    ]
  },
  "numerical_characteristics": {
    "dtype": null,
    "precision": null,
    "magnitude": "max gradient error ~1.85e-08 after fix versus ~0.97 before fix",
    "tolerance": null,
    "category_specific_evidence": [
      "Mathematical property violated: gradient of matrix_frac(X,P)=tr(X^T P^{-1} X) w.r.t. X is (P^{-1}+P^{-T})X, which must be vectorized in column-major (Fortran) order per CVXPY convention",
      "Bug: line used DX.T.ravel(order='F') which is equivalent to DX.ravel(order='C') (row-major), producing silently wrong gradients whenever X has more than one column",
      "For vector X (single column) the transpose is a no-op so the bug is masked",
      "Finite-difference check confirms fix produces correct gradients with max error ~1.85e-08 versus ~0.97 before the fix",
      "Impact: Atom.grad returns incorrect values for matrix_frac with matrix X, errors up to ~0.97; problem.backward() and problem.derivative() are not affected since they use diffcp",
      "Fix removes the .T so line reads DX.ravel(order='F'); gradient w.r.t. P is correct because its double-transpose cancels out",
      "Regression test added: matrix_frac_matrix_x config with unrestricted X of shape (3,2) and psd P of shape (3,3) in cvxpy/tests/test_grad.py"
    ],
    "reproduction_risks": [
      "Bug only manifests for matrix X with more than one column; a vector X reproduction will not expose it",
      "Reproduction must target Atom.grad directly, since problem.backward()/derivative() bypass the faulty path"
    ]
  },
