     } else {
       return random_binomial_btpe(bitgen_state, n, p, binomial);
     }
   } else {
     q = 1.0 - p;
     if (q * n <= 30.0) {
-      return n - random_binomial_inversion(bitgen_state, n, q, binomial);
+      return n - legacy_random_binomial_inversion(bitgen_state, n, q, binomial);
