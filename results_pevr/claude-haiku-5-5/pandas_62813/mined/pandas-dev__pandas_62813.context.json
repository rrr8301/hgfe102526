  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas._libs.lib.maybe_convert_numeric",
    "observed_behavior": "With pd.read_csv() and no dtype=, a column containing 42 and 18446744073709551616.5 (2^64 + 0.5) with no preceding float is returned as dtype object with string values ['42' '18446744073709551616.5'] instead of float64. In maybe_convert_numeric, integers out of range raised ValueError('Integer out of range.') when coerce_numeric was not set.",
    "expected_behavior": "The read_csv column should be detected as float64 with values [4.20000000e+01 1.84467441e+19], as happens when a preceding float is present. For maybe_convert_numeric with coerce_numeric=False, out-of-range integers should be returned as object dtype holding exact Python ints (e.g. 1<<65 and -(1<<65)); with coerce_numeric=True the result should be float dtype.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "pd.read_csv() called without dtype=",
      "the numeric column has no preceding float value",
      "the column contains integers or decimals at or above 2^64 (about 1.8447e19), e.g. 18446744073709551616.5",
      "maybe_convert_numeric is called with coerce_numeric=False (the default path) on an out-of-range integer, which raised ValueError before the fix"
    ],
    "input_output_examples": [
      {
        "input": "read_csv of a 'value' column containing 42 and 18446744073709551616.5, no dtype=",
        "buggy_output": "dtype object with values ['42' '18446744073709551616.5']",
        "expected_output": "dtype float64 with values [4.20"
      }
    ],
    "oracle_clues": []
  },
  "numerical_characteristics": {
    "dtype": "float64 (observed from read_csv); object dtype holding Python ints is the expected result",
    "precision": "float64 is the observed precision loss path; exact Python int is expected for values at or above 2^64, as the Series example shows 18446744073709551616",
    "magnitude": "values at or above 2^64 (about 1.8447e19), e.g. 18446744073709551616 and 1<<65 in the test",
    "tolerance": null,
    "category_specific_evidence": [
      "Issue#51295: read_csv on a column containing 42 and 18446744073709551616 gives float64 dtype and values [4.20000000e+01 1.84467441e+19] instead of exact integers.",
      "Issue#51295: the 'small int followed by 2**64 + 0.5' case should give float64 dtype, per maintainer comment.",
      "Issue#51295: pd.Series([1, 2**64]) gives dtype('O') with ser[1] equal to 18446744073709551616, a Python int; maintainer asks read_csv to be consistent with this.",
      "PR#62813 test test_convert_numeric_overflow expects exact Python ints (1<<65, -(1<<65)) with object dtype when coerce_numeric=False, and float dtype when coerce_numeric=True.",
