  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas.to_datetime",
    "observed_behavior": "Scalar uint64 input above the int64 max is silently wrapped and returned as a valid timestamp: pd.to_datetime(np.iinfo('uint64').max, unit='ns') prints 1969-12-31 23:59:59.999999999 with no error. The same overflow in to_timedelta is also silent before the fix.",
    "expected_behavior": "The out-of-bounds uint64 value should raise instead of returning a wrong result: OutOfBoundsDatetime for to_datetime and OutOfBoundsTimedelta for to_timedelta. With errors='coerce' it should fall through to the object code path, yielding pd.NaT for the scalar and TimedeltaIndex([pd.NaT]) for the array form.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "input is a uint64 value greater than the int64 max (e.g. np.iinfo('uint64').max = 18446744073709551615)",
      "scalar input passed to pd.to_datetime with unit='ns'",
      "to_timedelta with uint64 values above int64 max and unit='ns'"
    ],
    "input_output_examples": [
      {
        "input": "pd.to_datetime(np.iinfo('uint64').max, unit='ns') with uint64_max = 18446744073709551615",
        "buggy_output": "1969-12-31 23:59:59.999999999",
        "expected_output": "OutOfBoundsDatetime raised",
        "value_kind": "exception",
        "source": "issue:issue#60677 reproducer and PR#64755 description"
      },
      {
        "input": "to_timedelta(np.array([18446744073709551615], dtype=np.uint64), unit='ns', errors='coerce')",
        "buggy_output": "silent wrapped value (not NaT)",
        "expected_output": "TimedeltaIndex([pd.NaT])",
        "value_kind": "array",
        "source": "PR#64755 test diff"
      },
      {
        "input": "to_timedelta(18446744073709551615, unit='ns', errors='coerce')",
        "buggy_output": "silent wrapped value (not NaT)",
        "expected_output": "pd.NaT",
        "value_kind": "unknown",
        "source": "PR#64755 test diff"
      },
      {
        "input": "np.array([1_000_000, 2_000_000], dtype=np.uint64) with unit='ns'",
        "buggy_output": "null",
        "expected_output": "equal to to_timedelta of the int64-cast array",
        "value_kind": "array",
        "source": "PR#64755 valid passthrough test"
      }
    ],
    "oracle_clues": [
      "Issue #60677 reproducer prints 'Wrong:' with the wrapped timestamp; the list form raises 'cannot convert input 18446744073709551615 with the unit 'ns', at position 0'",
      "PR test diff asserts TimedeltaIndex([pd.NaT]) for array coerce and pd.NaT for scalar coerce",
      "Fix raises OutOfBoundsTimedelta in _ints_to_td64ns when uint64 data has any value > np.iinfo(np.int64).max, before astype(np.int64)",
      "Test plan covers array raise, array coerce, scalar raise, scalar coerce, scalar constructor raise, valid uint64 passthrough for both to_datetime and to_timedelta"
    ]
  },
  "numerical_characteristics": {
    "dtype": "uint64",
    "precision": null,
    "magnitude": "uint64 values greater than int64 max (e.g. np.iinfo(np.uint64).max = 18446744073709551615) with unit 'ns'",
    "tolerance": null,
    "category_specific_evidence": [
      "Issue #60677 reproducer: pd.to_datetime(uint64_max, unit='ns') returns 1969-12-31 23:59:59.999999999 silently (wrong result) for scalar input 18446744073709551615, while the list form raises 'cannot convert input 18446744073709551615 with the unit 'ns', at position 0'.",
      "Issue states expected behavior: out-of-bounds input should raise rather than silently wrap.",
      "PR body: to_datetime and to_timedelta silently overflow when given uint64 values greater than int64 max, returning wrong results instead of raising OutOfBoundsDatetime/OutOfBoundsTimedelta.",
      "Test diff: to_timedelta(np.array([uint64_max], dtype=np.uint64), unit='ns', errors='coerce') expected to equal TimedeltaIndex([pd.NaT]); scalar to_timedelta(uint64_max, unit='ns', errors='coerce') expected to be pd.NaT.",
      "Valid passthrough test: np.array([1_000_000, 2_000_000], dtype=np.uint64) with unit='ns' should equal to_timedelta of the int64-cast array.",
      "Fix in _ints_to_td64ns raises OutOfBoundsTimedelta when data.dtype is uint64 and any value exceeds np.iinfo(np.int64).max, before the astype(np.int64) cast."
    ],
    "reproduction_risks": [
      "Scalar path (pd.to_datetime on a Python/numpy scalar) may silently wrap while list/array path raises, so reproduction must test both scalar and array inputs.",
      "Reproduction should test errors='coerce' behavior, which should yield NaT rather than raise.",
      "The issue's reproducer was run on a specific pandas commit (0691c5cf90477d3503834d983f69350f250a6ff7); exact version not otherwise stated in passages."
    ]
