  "numerical_failure": {
    "category": "special_value",
    "affected_api": "pandas.arrays.PandasArray._from_sequence via pandas.array (pandas/core/arrays/numpy_.py NumpyExtensionArray._from_sequence)",
    "observed_behavior": "pd.array(float_data_with_nan, dtype=\"i8\") silently returns nonsensical integers, e.g. [-9223372036854775808, 1] for input [nan, 1.x] with dtype int64, instead of refusing the cast.",
    "expected_behavior": "pd.array should raise IntCastingNaNError for float data containing NaN cast to integer dtype (matching the Series and Index constructors), instead of producing nonsensical integer values.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "pd.array called with float data containing NaN",
      "dtype is an integer numpy dtype (i8/int64/u8/uint64)"
    ],
    "input_output_examples": [
      {
        "input": "arr = np.random.randn(2); arr[0] = np.nan; pd.array(arr, dtype=\"i8\")",
        "buggy_output": "<PandasArray> [-9223372036854775808, 1] Length: 2, dtype: int64",
        "expected_output": "raises IntCastingNaNError",
        "value_kind": "exception",
        "source": "issue#41724"
      }
    ],
    "oracle_clues": [
      "Fix raises IntCastingNaNError, matching Series and Index constructors",
      "Parametrized test added for i8, int64, u8, uint64 dtypes",
      "Existing tests test_array.py, test_numpy.py, test_astype.py"
    ]
  },
