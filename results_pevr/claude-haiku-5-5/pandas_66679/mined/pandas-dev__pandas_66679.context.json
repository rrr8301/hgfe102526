  "numerical_failure": {
    "category": "correctness",
    "affected_api": "pandas._libs.tslibs.offsets.Day._apply_array",
    "observed_behavior": "For tz-aware DatetimeIndex, adding a Day offset with an out-of-bounds result silently wraps to an unrelated date, and a result landing exactly on the NaT sentinel returns NaT (a missing value) instead of raising OverflowError. Example: dti.tz_localize(\"UTC\") + pd.offsets.Day(-1) returns NaT; dti.tz_localize(\"UTC\") + pd.offsets.Day(-2) returns 2262-04-10 (wrapped).",
    "expected_behavior": "Out-of-bounds or NaT-sentinel-landing results should raise OverflowError, matching the tz-naive path (dti + pd.offsets.Day(-1) raises OverflowError); in-bounds results and NaT propagation unchanged.",
    "manifestation": "wrong_value",
    "trigger_conditions": [
      "DatetimeIndex with values near the int64 bounds (e.g. iNaT + 86400*10**9) made tz-aware via tz_localize",
      "Day offset with n such that the shifted result lands on NaT sentinel or overflows int64 bounds",
      "n large enough to overflow int64 during unit conversion to the array's resolution (via checked_mul)"
    ],
    "input_output_examples": [
      {
        "input": "dti = pd.DatetimeIndex([pd.Timestamp(iNaT + 86400 * 10**9)]); dti.tz_localize(\"UTC\") + pd.offsets.Day(-1)",
        "buggy_output": "NaT",
        "expected_output": "OverflowError",
        "value_kind": "exception",
        "source": "pr_body:PR#66679"
      },
      {
        "input": "dti = pd.DatetimeIndex([pd.Timestamp(iNaT + 86400 * 10**9)]); dti.tz_localize(\"UTC\") + pd.offsets.Day(-2)",
        "buggy_output": "2262-04-10",
        "expected_output": "OverflowError",
        "value_kind": "exception",
        "source": "pr_body:PR#66679"
      },
      {
        "input": "dti = pd.DatetimeIndex([pd.Timestamp(iNaT + 86400 * 10**9)]); dti + pd.offsets.Day(-1)",
        "buggy_output": "OverflowError",
        "expected_output": "OverflowError",
        "value_kind": "exception",
        "source": "pr_body:PR#66679"
      }
    ],
    "oracle_clues": [
      "Tz-naive path raising OverflowError is the reference behaviour",
      "Mirrors Week._apply_array implementation using checked_mul and add_overflowsafe",
      "Changelog entry: 'instead of raising OverflowError as the timezone-naive equivalent already did (:issue:`66552`)'"
    ]
  },
  "numerical_characteristics": {
    "dtype": "datetime64 (tz-aware, tz='UTC' in the examples); unit s or ns in the tests",
    "precision": "unit 's' or 'ns' (datetime64[s] or datetime64[ns])",
    "magnitude": "values near the NaT sentinel iNaT; a shift of 86400*10**9 added to iNaT; Day(-1) and Day(-2) on that index; n=2**32 for Week and month-based offsets (wraps to n=0); Day(2**60) overflows int64 during unit conversion",
    "tolerance": null,
    "category_specific_evidence": [
      "Property violated: shifting a tz-aware DatetimeIndex by Day(n) must match the tz-naive result and must raise OverflowError ('Overflow in int64 addition') when the result is out of bounds, instead of returning NaT or wrapping to an unrelated date.",
      "Reproducer: dti = pd.DatetimeIndex([pd.Timestamp(iNaT + 86400 * 10**9)]); dti + pd.offsets.Day(-1) raises OverflowError; dti.tz_localize('UTC') + pd.offsets.Day(-1) returns NaT (silently missing); dti.tz_localize('UTC') + pd.offsets.Day(-2) returns 2262-04-10 (silently wrapped).",
      "Cause: Day._apply_array used a raw numpy add with np.timedelta64(self._n, 'D'); the fix converts n to the array's unit via checked_mul(self._n, periods_per_day(reso)), rejects shift == NPY_NAT, and adds via add_overflowsafe.",
      "Test expectations: test_dt64arr_add_day_lands_on_nat_sentinel parametrized over unit in ['s','ns'] and tz in [None,'UTC'] expects OverflowError; obj + Day(2**60) expects OverflowError; test_dt64arr_add_day_tzaware_matches_naive checks in-bounds results equal the tz-naive results and NaT propagates.",
      "Related wrap bug (GH#66549): Week and month/quarter/half-year/year/semi-month offsets with n of magnitude 2**31 or"
    ],
    "reproduction_risks": []
  },
