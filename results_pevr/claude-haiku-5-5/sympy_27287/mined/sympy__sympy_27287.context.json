  "numerical_failure": {
    "category": "correctness",
    "affected_api": "sympy.core.sympify._convert_numpy_types",
    "observed_behavior": "Calling sympy.Float(np.float32(float('inf'))) raises OverflowError: cannot convert Infinity to integer ratio, raised from _convert_numpy_types calling a.as_integer_ratio() on the infinite numpy float.",
    "expected_behavior": "Infinite numpy floats should be converted to SymPy infinity: np.isposinf(a) returns Float('inf') and np.isneginf(a) returns Float('-inf') instead of calling as_integer_ratio.",
    "manifestation": "exception",
    "trigger_conditions": [
      "input is a numpy floating value equal to positive or negative infinity, e.g. np.float32(float('inf'))",
      "conversion goes through sympy.Float / _convert_numpy_types, which calls as_integer_ratio on the value",
      "numpy 2.1.3 and sympy 1.13.3 with Python 3.10.15 were reported"
    ],
    "input_output_examples": [
      {
        "input": "sympy.Float(np.float32(float('inf')))",
        "buggy_output": "OverflowError: cannot convert Infinity to integer ratio",
        "expected_output": "Float('inf')",
        "value_kind": "exception",
        "source": "issue#27284 reproducer and PR#27287 fix"
      },
      {
        "input": "sympify(np.float32('-inf')) (negative infinity case covered by the fix)",
        "buggy_output": "OverflowError: cannot convert Infinity to integer ratio",
        "expected_output": "Float('-inf')",
        "value_kind": "exception",
        "source": "PR#27287 diff"
      }
    ],
    "oracle_clues": [
      "Traceback shows OverflowError raised at sympify.py _convert_numpy_types line p, q = a.as_integer_ratio()",
      "PR#27287 adds an isposinf/isneginf check returning Float('inf') / Float('-inf')",
      "PR added a new test case per commit message"
    ]
  },
  "numerical_characteristics": {
    "dtype": "numpy.float32",
    "precision": null,
    "magnitude": "infinite values (inf and -inf)",
    "tolerance": null,
    "category_specific_evidence": [
      "Passage shows the bug: sympy.Float(np.float32(float('inf'))) fails because _convert_numpy_types calls a.as_integer_ratio(), which raises OverflowError: cannot convert Infinity to integer ratio.",
      "The fix in sympy/core/sympify.py checks np.isposinf(a) and returns Float('inf'), and checks np.isneginf(a) and returns Float('-inf') before the as_integer_ratio conversion.",
      "The added test test_issue_27284 asserts Float(numpy.float32(float('inf'))) == S.Infinity and Float(numpy.float32(float('-inf'))) == S.NegativeInfinity, skipping if numpy is not installed.",
      "Release note: sympify fails for infinite floats such as sympify(np.float32('inf')); the fix is a correctness fix for infinite-input handling rather than a stated rounding or precision property.",
